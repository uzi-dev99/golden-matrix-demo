# Copy to .env.local. Placeholders only: never commit real values.
OPENROUTER_API_KEY=sk-or-replace-me
# Optional, server-only: MiniMax's own API key. Enables `minimax/<model>` entries in the allow-list
# (use minimax/MiniMax-M2.7: M3.1-Flash can spend the whole output budget reasoning and return no text).
# MINIMAX_API_KEY=
# Comma-separated allow-list (OpenRouter ids or minimax/<model>); the first usable entry is the default.
# Models whose provider has no key here are left out (e.g. online: OpenRouter only; LAN: MiniMax first).
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/free,google/gemma-4-31b-it:free
SESSION_SECRET=replace-with-at-least-32-random-characters
DEMO_USER=demo
DEMO_PASSWORD=change-me
# Public URL of the deployment (OpenRouter HTTP-Referer / Nominatim User-Agent contact).
# In a deploy use the https URL (or leave it unset): an explicit http:// URL turns off the Secure session cookie (LAN runs only).
# SITE_URL=https://your-domain.example
# Report generations per IP per hour (in-memory, per instance).
RATE_LIMIT_PER_HOUR=20
# Number of trusted reverse-proxy hops in X-Forwarded-For.
TRUSTED_PROXY_HOPS=1
