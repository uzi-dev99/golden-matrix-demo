# Copy to .env.local. Placeholders only: never commit real values.
OPENROUTER_API_KEY=sk-or-replace-me
# Comma-separated allow-list; the first entry is the default model.
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/free,google/gemma-4-31b-it:free
SESSION_SECRET=replace-with-at-least-32-random-characters
DEMO_USER=demo
DEMO_PASSWORD=change-me
# Public URL of the deployment (OpenRouter HTTP-Referer / Nominatim User-Agent contact).
SITE_URL=http://localhost:3100
# Report generations per IP per hour (in-memory, per instance).
RATE_LIMIT_PER_HOUR=20
# Number of trusted reverse-proxy hops in X-Forwarded-For.
TRUSTED_PROXY_HOPS=1
